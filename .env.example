# ---- Supabase ----
# Project URL and service role key (Project Settings -> API).
# The service key bypasses row-level security: keep it server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- xAI / Grok ----
# Without a key the app runs on the mock model and clearly labels its output.
XAI_API_KEY=your-xai-api-key
GROK_MODEL=grok-4.20-0309-non-reasoning
GROK_MAX_TOKENS=4000
GROK_MAX_RETRIES=4

# ---- Embeddings ----
# EMBED_DIM must match the vector(N) columns in sql/001_tables.sql.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# ---- Generation ----
TARGET_HANDBOOK_WORDS=20000
